{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "description": "__MSG_ext_desc__",
  "version": "3.6.1",
  "version_name": "3.6.1",
  "author": "Bener",
  "default_locale": "en",

  "icons": {
    "16": "assets/logo.png",
    "32": "assets/logo.png",
    "48": "assets/logo.png",
    "128": "assets/logo.png",
    "512": "assets/logo.png"
  },

  "action": {
    "default_icon": {
      "16": "assets/logo.png",
      "24": "assets/logo.png",
      "32": "assets/logo.png"
    },
    "default_popup": "./dist/popup/index.html",
    "default_title": "__MSG_ext_name__"
  },

  "background": {
    "service_worker": "./dist/background/index.mjs"
  },

  "options_ui": {
    "page": "./dist/options/index.html",
    "open_in_tab": true
  },

  "content_scripts": [{
    "matches": [
      "*://*/*.md", "*://*/*.mdx", "*://*/*.mdc", "*://*/*.mkd",
      "*://*/*.txt", "*://*/*.markdown",
      "*://*/*.MD", "*://*/*.MDX", "*://*/*.MDC", "*://*/*.MKD",
      "*://*/*.TXT", "*://*/*.MARKDOWN",
      "file://*/*.md", "file://*/*.mdx", "file://*/*.mdc", "file://*/*.mkd",
      "file://*/*.txt", "file://*/*.markdown",
      "file://*/*.MD", "file://*/*.MDX", "file://*/*.MDC", "file://*/*.MKD",
      "file://*/*.TXT", "file://*/*.MARKDOWN",
      "*://*/*.md?*", "*://*/*.mdx?*", "*://*/*.mdc?*", "*://*/*.mkd?*",
      "*://*/*.txt?*", "*://*/*.markdown?*",
      "*://*/*.MD?*", "*://*/*.MDX?*", "*://*/*.MDC?*", "*://*/*.MKD?*",
      "*://*/*.TXT?*", "*://*/*.MARKDOWN?*",
      "file://*/*.md?*", "file://*/*.mdx?*", "file://*/*.mdc?*",
      "file://*/*.mkd?*", "file://*/*.txt?*", "file://*/*.markdown?*",
      "file://*/*.MD?*", "file://*/*.MDX?*", "file://*/*.MDC?*",
      "file://*/*.MKD?*", "file://*/*.TXT?*", "file://*/*.MARKDOWN?*",
      "file://*/", "file:///"
    ],
    "js": ["./dist/content/index.global.js", "./dist/content/three-column.js"],
    "css": ["./dist/content/style.css", "./dist/content/three-column.css"],
    "run_at": "document_start"
  }],

  "permissions": ["storage", "tabs"],

  "commands": {
    "toggleSide": {
      "description": "__MSG_command_toggle_side__",
      "suggested_key": { "default": "Alt+Shift+B" }
    },
    "toggleCentered": {
      "description": "__MSG_command_toggle_centered__",
      "suggested_key": { "default": "Alt+Shift+C" }
    },
    "togglePageTheme": {
      "description": "__MSG_command_toggle_theme__",
      "suggested_key": { "default": "Alt+Shift+T" }
    },
    "toggleRefresh": {
      "description": "__MSG_command_toggle_refresh__",
      "suggested_key": { "default": "Alt+Shift+R" }
    }
  },

  "homepage_url": "https://md-reader.github.io",

  "web_accessible_resources": [{
    "matches": ["<all_urls>"],
    "resources": ["assets/*", "dist/popup/*", "dist/options/*"]
  }],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
